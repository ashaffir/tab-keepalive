{
  "manifest_version": 3,
  "name": "Local Tab Keepalive",
  "version": "3.0.0",
  "description": "Local layered session keeper with generic session diagnostics and multiple keepalive strategies.",
  "incognito": "split",
  "permissions": [
    "alarms",
    "cookies",
    "debugger",
    "power",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Local Tab Keepalive",
    "default_popup": "popup.html"
  }
}
